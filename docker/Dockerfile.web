FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache openssl
RUN corepack enable

COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_NEW_CATALOG_FRONTEND=false
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_NEW_CATALOG_FRONTEND=$NEXT_PUBLIC_NEW_CATALOG_FRONTEND
RUN pnpm install
RUN pnpm --filter @caracal/web... build

EXPOSE 3000
CMD ["pnpm", "--filter", "@caracal/web", "start"]
