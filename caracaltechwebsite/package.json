    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "express-validator": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "typesense": "^1.5.8",
    "csv-parse": "^5.4.1",
    "lodash": "^4.17.21",
    "pino": "^8.16.1",
    "pino-pretty": "^10.2.3",
