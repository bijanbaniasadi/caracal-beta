# App
APP_NAME=caracal-tech-motors
NODE_ENV=development
WEB_NODE_OPTIONS=--max-old-space-size=512
API_NODE_OPTIONS=--max-old-space-size=768
WORKER_NODE_OPTIONS=--max-old-space-size=768

# API
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://caracal:caracal_dev@localhost:5432/caracal_dev
POSTGRES_USER=caracal
POSTGRES_PASSWORD=caracal_dev
POSTGRES_DB=caracal_dev
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_KEEP_ALIVE_MS=30000
REDIS_RECONNECT_BASE_DELAY_MS=500
REDIS_RECONNECT_MAX_DELAY_MS=10000
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=dev-typesense-key
TYPESENSE_COLLECTION_ALIAS=products
TYPESENSE_COLLECTION_PREFIX=products
CATALOG_INGESTION_QUEUE_NAME=ingestion
CATALOG_FINGERPRINT_QUEUE_NAME=fingerprint
CATALOG_IMAGE_PIPELINE_QUEUE_NAME=image-pipeline
CATALOG_PROJECTION_QUEUE_NAME=projection
CATALOG_SEARCH_INDEX_QUEUE_NAME=search-index
CATALOG_RECONCILIATION_QUEUE_NAME=reconciliation
CATALOG_QUEUE_ATTEMPTS=3
CATALOG_QUEUE_BACKOFF_MS=30000
CATALOG_QUEUE_REMOVE_COMPLETE=1000
CATALOG_QUEUE_REMOVE_FAILED=5000
CATALOG_PROJECTION_WORKER_CONCURRENCY=1
CATALOG_MATVIEW_REFRESH_DEBOUNCE_MS=30000
CATALOG_INGESTION_WORKER_CONCURRENCY=1
CATALOG_FINGERPRINT_WORKER_CONCURRENCY=1
CATALOG_IMAGE_PIPELINE_WORKER_CONCURRENCY=1
CATALOG_RECONCILIATION_WORKER_CONCURRENCY=1

# Auth
JWT_SECRET=dev-secret-at-least-32-characters-long
REFRESH_TOKEN_SECRET=dev-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12
AUTH_REFRESH_COOKIE_NAME=caracal_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_MAX=20
ADMIN_EMAIL=admin@caracaltechmotors.com
ADMIN_PASSWORD=ChangeMeAdmin123!

# Stripe payments
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_WEBHOOK_ENDPOINT=/api/checkout/webhook/stripe

# Storage
STORAGE_TYPE=local
BIN_UPLOAD_MAX_SIZE=52428800
LOCAL_UPLOAD_DIR=uploads
UPLOAD_RATE_LIMIT_MAX=12
INTAKE_RATE_LIMIT_MAX=30

# BIN analysis pipeline
BIN_ANALYSIS_AUTO_QUEUE=true
BIN_ANALYSIS_QUEUE_NAME=bin-analysis
BIN_ANALYSIS_MAX_ATTEMPTS=3
BIN_ANALYSIS_RETRY_BACKOFF_MS=30000
BIN_ANALYSIS_WORKER_CONCURRENCY=2
BIN_ANALYSIS_WORKER_PM2_INSTANCES=1
BIN_ANALYSIS_LOCK_DURATION_MS=30000
BIN_ANALYSIS_STALLED_INTERVAL_MS=30000
BIN_ANALYSIS_MAX_STALLED_COUNT=2
BIN_ANALYSIS_STALLED_AFTER_MS=300000
BIN_ANALYSIS_STALLED_RECOVERY_LIMIT=25
BIN_ANALYSIS_CLEANUP_INTERVAL_MS=900000
BIN_ANALYSIS_FAILED_JOB_RETENTION_MS=604800000
BIN_ANALYSIS_COMPLETED_JOB_RETENTION_MS=86400000
BIN_ANALYSIS_CLEANUP_LIMIT=1000
BIN_ANALYSIS_REMOVE_ON_COMPLETE_COUNT=1000
BIN_ANALYSIS_REMOVE_ON_FAIL_COUNT=5000
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_STALE_AFTER_MS=60000
WORKER_SHUTDOWN_TIMEOUT_MS=30000
PM2_KILL_TIMEOUT_MS=30000
PM2_RESTART_BACKOFF_MS=1000

# ECU corpus indexing
ECU_CORPUS_ROOT=C:\Users\Bijan\Desktop\SAFE\Damos and files
ECU_CORPUS_MAX_ANALYSIS_BYTES=2097152
ECU_CORPUS_MAX_PAIR_CANDIDATES=5000

# Cloudflare R2 (S3-compatible, optional)
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Catalog object storage (S3-compatible, optional until image/raw HTML promotion lands)
CATALOG_OBJECT_STORAGE_ENDPOINT=
CATALOG_OBJECT_STORAGE_REGION=auto
CATALOG_IMAGE_BUCKET=caracal-images
CATALOG_RAW_HTML_BUCKET=caracal-html-raw
CATALOG_BACKUP_BUCKET=caracal-backups
CATALOG_OBJECT_STORAGE_ACCESS_KEY_ID=
CATALOG_OBJECT_STORAGE_SECRET_ACCESS_KEY=
CATALOG_IMAGE_PUBLIC_BASE_URL=
CATALOG_RAW_ASSET_DIR=apps/api/storage/catalog-raw
MK3_INGESTION_USER_AGENT=CaracalTechBot/0.1 staged-ingestion
MK3_INGESTION_MAX_PAGES=1
MK3_INGESTION_FIXTURE_PATH=
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=debug

# Security
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX_REQUESTS=100
CATALOG_SYNC_RATE_LIMIT_MAX=120
SUPPLIER_SYNC_MIN_SALE_PRICE_CENTS=10000
SUPPLIER_SYNC_MAX_SALE_PRICE_CENTS=20000000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
