# App
APP_NAME=caracal-tech-motors
NODE_ENV=development

# API
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://caracal:caracal_dev@localhost:5432/caracal_dev

# Auth
JWT_SECRET=dev-secret-at-least-32-characters-long
REFRESH_TOKEN_SECRET=dev-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12
AUTH_REFRESH_COOKIE_NAME=caracal_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_MAX=20
ADMIN_EMAIL=admin@caracaltechmotors.com
ADMIN_PASSWORD=ChangeMeAdmin123!

# Storage
STORAGE_TYPE=local
BIN_UPLOAD_MAX_SIZE=52428800
LOCAL_UPLOAD_DIR=uploads
UPLOAD_RATE_LIMIT_MAX=12
INTAKE_RATE_LIMIT_MAX=30

# Cloudflare R2 (S3-compatible, optional)
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Logging
LOG_LEVEL=debug

# Security
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
