generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  role          UserRole       @default(CUSTOMER)
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  carts         Cart[]
  articles      Article[]      @relation("ArticleAuthor")
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum IntakeStatus {
  NEW
  IN_REVIEW
  RESPONDED
  CLOSED
  SPAM
}

enum BinUploadStatus {
  RECEIVED
  VALIDATED
  REJECTED
  STORED
}

enum BinAnalysisJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum BinAnalysisStage {
  QUEUED
  FILE_HASHING
  MCU_DETECTION
  METADATA_EXTRACTION
  RESULT_STORAGE
  COMPLETED
  FAILED
}

enum BinAnalysisResultKind {
  PIPELINE_SUMMARY
  FILE_METADATA
  MCU_DETECTION
}

enum StorageProvider {
  LOCAL
  R2
}

enum AuditActorType {
  ANONYMOUS
  USER
  SYSTEM
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CHECKED_OUT
  EXPIRED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  familyId          String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
}

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  contentHtml    String?
  status         ArticleStatus @default(DRAFT)
  category       String?
  coverImage     String?
  thumbnailImage String?
  seoTitle       String?
  seoDescription String?
  keywords       String[]      @default([])
  isFeatured     Boolean       @default(false)
  authorId       String?
  author         User?         @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  metadata       Json?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@index([authorId])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([createdAt])
}

model Supplier {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  websiteUrl   String?
  notes        String?
  metadata     Json?
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([name])
  @@index([createdAt])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([createdAt])
}

model Product {
  id               String           @id @default(cuid())
  sku              String           @unique
  slug             String           @unique
  name             String
  shortDescription String?
  description      String?
  status           ProductStatus    @default(DRAFT)
  priceCents       Int?
  currency         String           @default("AED")
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  inventoryItems   InventoryItem[]
  cartItems        CartItem[]
  inquiries        ProductInquiry[]
  isFeatured       Boolean          @default(false)
  isB2BEligible    Boolean          @default(false)
  isTradeOnly      Boolean          @default(false)
  tradePriceCents  Int?
  attributes       Json?
  metadata         Json?
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([supplierId])
  @@index([isFeatured])
  @@index([isB2BEligible])
  @@index([isTradeOnly])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, url])
  @@index([productId, sortOrder])
  @@index([isPrimary])
}

model InventoryItem {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationKey      String          @default("default")
  locationLabel    String?
  quantityOnHand   Int             @default(0)
  quantityReserved Int             @default(0)
  reorderPoint     Int             @default(0)
  status           InventoryStatus @default(IN_STOCK)
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([productId, locationKey])
  @@index([status])
  @@index([createdAt])
}

model Cart {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId   String?    @unique
  status      CartStatus @default(ACTIVE)
  currency    String     @default("AED")
  items       CartItem[]
  metadata    Json?
  expiresAt   DateTime?
  convertedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int      @default(1)
  unitPriceCents Int?
  currency       String   @default("AED")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
  @@index([createdAt])
}

model BinUpload {
  id               String              @id @default(cuid())
  originalFileName String
  storedObjectKey  String              @unique
  storageProvider  StorageProvider     @default(LOCAL)
  mimeType         String
  byteSize         Int
  sha256           String
  status           BinUploadStatus     @default(RECEIVED)
  requesterName    String?
  requesterEmail   String?
  productContext   String?
  notes            String?
  rejectionReason  String?
  metadata         Json?
  quoteRequestId   String?
  quoteRequest     QuoteRequest?       @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  analysisJobs     BinAnalysisJob[]
  analysisResults  BinAnalysisResult[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([requesterEmail])
  @@index([sha256])
  @@index([quoteRequestId])
  @@index([createdAt])
}

model BinAnalysisJob {
  id           String               @id @default(cuid())
  uploadId     String
  upload       BinUpload            @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  queueName    String
  bullJobId    String?              @unique
  status       BinAnalysisJobStatus @default(QUEUED)
  stage        BinAnalysisStage     @default(QUEUED)
  priority     Int                  @default(0)
  attempts     Int                  @default(0)
  maxAttempts  Int                  @default(3)
  progress     Int                  @default(0)
  errorCode    String?
  errorMessage String?
  queuedAt     DateTime             @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  nextRetryAt  DateTime?
  metadata     Json?
  results      BinAnalysisResult[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([uploadId])
  @@index([status])
  @@index([stage])
  @@index([queueName])
  @@index([createdAt])
}

model BinAnalysisResult {
  id              String                @id @default(cuid())
  jobId           String                @unique
  job             BinAnalysisJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadId        String
  upload          BinUpload             @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  kind            BinAnalysisResultKind @default(PIPELINE_SUMMARY)
  fileSha256      String
  fileSizeBytes   Int
  mcuFamily       String?
  mcuConfidence   Float?
  resultObjectKey String?
  storageProvider StorageProvider?
  summary         Json?
  metadata        Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([uploadId])
  @@index([kind])
  @@index([fileSha256])
  @@index([mcuFamily])
  @@index([createdAt])
}

model WorkerHeartbeat {
  id          String    @id @default(cuid())
  workerId    String    @unique
  workerType  String
  queueName   String
  status      String
  processId   Int?
  hostname    String?
  concurrency Int?
  startedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  stoppedAt   DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workerType])
  @@index([queueName])
  @@index([status])
  @@index([lastSeenAt])
}

model QuoteRequest {
  id             String       @id @default(cuid())
  referenceCode  String       @unique
  customerName   String
  customerEmail  String
  customerPhone  String?
  companyName    String?
  workshopName   String?
  vehicleDetails String?
  requestedItems Json?
  message        String
  status         IntakeStatus @default(NEW)
  source         String       @default("api")
  metadata       Json?
  binUploads     BinUpload[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
}

model ProductInquiry {
  id            String       @id @default(cuid())
  referenceCode String       @unique
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSku    String?
  productName   String
  customerName  String
  customerEmail String
  customerPhone String?
  companyName   String?
  quantity      Int?
  message       String
  status        IntakeStatus @default(NEW)
  source        String       @default("api")
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([customerEmail])
  @@index([productId])
  @@index([productSku])
  @@index([status])
  @@index([createdAt])
}

model WorkshopConsultationLead {
  id                String       @id @default(cuid())
  referenceCode     String       @unique
  workshopName      String
  contactName       String
  contactEmail      String
  contactPhone      String?
  location          String?
  monthlyVolume     Int?
  serviceInterests  Json?
  preferredTimeline String?
  message           String
  status            IntakeStatus @default(NEW)
  source            String       @default("api")
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([contactEmail])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType @default(ANONYMOUS)
  actorId    String?
  action     String
  entityType String
  entityId   String?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([requestId])
  @@index([createdAt])
}

model EcuAnalysisRun {
  id                     String                     @id @default(cuid())
  rootPath               String
  status                 String                     @default("RUNNING")
  startedAt              DateTime                   @default(now())
  completedAt            DateTime?
  totalFiles             Int                        @default(0)
  indexedFiles           Int                        @default(0)
  unreadableFiles        Int                        @default(0)
  duplicateFiles         Int                        @default(0)
  clusterCount           Int                        @default(0)
  knownFamilyCount       Int                        @default(0)
  unknownFamilyCount     Int                        @default(0)
  oriModPairCount        Int                        @default(0)
  extensionBreakdown     Json?
  summary                Json?
  failedFiles            Json?
  metadata               Json?
  corpusFiles            EcuCorpusFile[]
  clusters               EcuFileCluster[]
  unknownFamilies        EcuUnknownFamily[]
  oriModPairs            EcuOriModPair[]
  modificationSignatures EcuModificationSignature[]
  learnedSignatures      EcuLearnedSignature[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([status])
  @@index([rootPath])
  @@index([startedAt])
}

model EcuCorpusFile {
  id                 String                 @id @default(cuid())
  runId              String?
  run                EcuAnalysisRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)
  rootPath           String
  relativePath       String
  fullPath           String                 @unique
  fileName           String
  extension          String
  detectedKind       String
  sizeBytes          BigInt
  sha256             String
  createdAtOnDisk    DateTime?
  modifiedAtOnDisk   DateTime?
  indexedAt          DateTime               @default(now())
  isReadable         Boolean                @default(true)
  readError          String?
  metadata           Json?
  fingerprint        EcuBinaryFingerprint?
  clusterMemberships EcuFileClusterMember[]
  detectedFamilies   EcuDetectedFamily[]
  projectLabels      EcuProjectLabel[]
  mapDefinitions     EcuMapDefinition[]
  mapRegions         EcuMapRegion[]
  checksumCandidates EcuChecksumCandidate[]
  dtcCandidates      EcuDtcCandidate[]
  originalPairs      EcuOriModPair[]        @relation("EcuOriginalFile")
  modifiedPairs      EcuOriModPair[]        @relation("EcuModifiedFile")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([runId])
  @@index([sha256])
  @@index([extension])
  @@index([detectedKind])
  @@index([fileName])
  @@index([sizeBytes])
  @@index([indexedAt])
}

model EcuBinaryFingerprint {
  id                  String        @id @default(cuid())
  fileId              String        @unique
  file                EcuCorpusFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  entropy             Float?
  entropyProfile      Json?
  architecture        String?
  supplier            String?
  probableOem         String?
  controllerType      String?
  fuelType            String?
  softwareVersion     String?
  hardwareNumber      String?
  filenameTokens      Json?
  stringTable         Json?
  byteSignatures      Json?
  vectorPatterns      Json?
  calibrationRegions  Json?
  mapBlockCandidates  Json?
  checksumCandidates  Json?
  dtcCandidates       Json?
  intelligenceSummary Json?
  metadata            Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([architecture])
  @@index([supplier])
  @@index([probableOem])
}

model EcuFileCluster {
  id          String                     @id @default(cuid())
  runId       String
  run         EcuAnalysisRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  clusterKey  String
  clusterType String
  label       String
  familyKey   String?
  confidence  Float                      @default(0)
  memberCount Int                        @default(0)
  evidence    Json?
  metadata    Json?
  members     EcuFileClusterMember[]
  unknown     EcuUnknownFamily?
  signatures  EcuLearnedSignature[]
  modSigns    EcuModificationSignature[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([runId, clusterKey])
  @@index([clusterType])
  @@index([familyKey])
  @@index([confidence])
}

model EcuFileClusterMember {
  id        String         @id @default(cuid())
  clusterId String
  cluster   EcuFileCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  fileId    String
  file      EcuCorpusFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  score     Float          @default(0)
  evidence  Json?
  createdAt DateTime       @default(now())

  @@unique([clusterId, fileId])
  @@index([fileId])
  @@index([score])
}

model EcuDetectedFamily {
  id             String        @id @default(cuid())
  fileId         String
  file           EcuCorpusFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  familyKey      String
  familyLabel    String
  supplier       String?
  oem            String?
  controllerType String?
  fuelType       String?
  architecture   String?
  confidence     Float         @default(0)
  evidence       Json?
  createdAt      DateTime      @default(now())

  @@index([fileId])
  @@index([familyKey])
  @@index([supplier])
  @@index([oem])
  @@index([confidence])
}

model EcuUnknownFamily {
  id          String          @id @default(cuid())
  runId       String
  run         EcuAnalysisRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  clusterId   String?         @unique
  cluster     EcuFileCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  unknownKey  String
  label       String
  confidence  Float           @default(0)
  memberCount Int             @default(0)
  evidence    Json?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([runId, unknownKey])
  @@index([confidence])
}

model EcuProjectLabel {
  id             String             @id @default(cuid())
  fileId         String
  file           EcuCorpusFile      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  labelType      String
  name           String
  address        BigInt?
  dataType       String?
  unit           String?
  factor         Float?
  offset         Float?
  source         String?
  confidence     Float              @default(0)
  comments       String?
  metadata       Json?
  mapDefinitions EcuMapDefinition[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([fileId])
  @@index([labelType])
  @@index([name])
  @@index([address])
}

model EcuMapDefinition {
  id        String           @id @default(cuid())
  fileId    String
  file      EcuCorpusFile    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  labelId   String?
  label     EcuProjectLabel? @relation(fields: [labelId], references: [id], onDelete: SetNull)
  name      String
  address   BigInt?
  dataType  String?
  axes      Json?
  factor    Float?
  offset    Float?
  unit      String?
  comments  String?
  metadata  Json?
  regions   EcuMapRegion[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([fileId])
  @@index([labelId])
  @@index([name])
  @@index([address])
}

model EcuMapRegion {
  id              String            @id @default(cuid())
  fileId          String
  file            EcuCorpusFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  mapDefinitionId String?
  mapDefinition   EcuMapDefinition? @relation(fields: [mapDefinitionId], references: [id], onDelete: SetNull)
  offset          BigInt?
  length          Int?
  regionType      String
  confidence      Float             @default(0)
  evidence        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([fileId])
  @@index([mapDefinitionId])
  @@index([regionType])
  @@index([offset])
}

model EcuOriModPair {
  id                       String                     @id @default(cuid())
  runId                    String
  run                      EcuAnalysisRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  originalFileId           String
  originalFile             EcuCorpusFile              @relation("EcuOriginalFile", fields: [originalFileId], references: [id], onDelete: Cascade)
  modifiedFileId           String
  modifiedFile             EcuCorpusFile              @relation("EcuModifiedFile", fields: [modifiedFileId], references: [id], onDelete: Cascade)
  confidence               Float                      @default(0)
  sizeBytes                BigInt
  shaDistance              Float?
  changedRegions           Json?
  probableModificationType String?
  changedMapCandidates     Json?
  evidence                 Json?
  modificationSignatures   EcuModificationSignature[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@unique([runId, originalFileId, modifiedFileId])
  @@index([runId])
  @@index([confidence])
}

model EcuModificationSignature {
  id            String          @id @default(cuid())
  runId         String
  run           EcuAnalysisRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  clusterId     String?
  cluster       EcuFileCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  pairId        String?
  pair          EcuOriModPair?  @relation(fields: [pairId], references: [id], onDelete: SetNull)
  signatureType String
  signatureKey  String
  confidence    Float           @default(0)
  regions       Json?
  evidence      Json?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([runId])
  @@index([clusterId])
  @@index([pairId])
  @@index([signatureType])
  @@index([confidence])
}

model EcuChecksumCandidate {
  id         String        @id @default(cuid())
  fileId     String
  file       EcuCorpusFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  family     String
  offset     BigInt?
  length     Int?
  confidence Float         @default(0)
  evidence   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([fileId])
  @@index([family])
  @@index([confidence])
}

model EcuDtcCandidate {
  id          String        @id @default(cuid())
  fileId      String
  file        EcuCorpusFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  offset      BigInt?
  length      Int?
  encoding    String
  confidence  Float         @default(0)
  sampleCodes Json?
  evidence    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([fileId])
  @@index([encoding])
  @@index([confidence])
}

model EcuLearnedSignature {
  id            String          @id @default(cuid())
  runId         String
  run           EcuAnalysisRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  clusterId     String?
  cluster       EcuFileCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  signatureType String
  signatureKey  String
  label         String
  confidence    Float           @default(0)
  evidence      Json?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([runId])
  @@index([clusterId])
  @@index([signatureType])
  @@index([signatureKey])
  @@index([confidence])
}
