  @@index([labelId])
  @@index([name])
  @@index([address])
}

model EcuMapRegion {
  id              String            @id @default(cuid())
  fileId          String
  file            EcuCorpusFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  mapDefinitionId String?
  mapDefinition   EcuMapDefinition? @relation(fields: [mapDefinitionId], references: [id], onDelete: SetNull)
  offset          BigInt?
  length          Int?
  regionType      String
  confidence      Float             @default(0)
  evidence        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([fileId])
  @@index([mapDefinitionId])
  @@index([regionType])
  @@index([offset])
}

model EcuOriModPair {
  id                       String                     @id @default(cuid())
  runId                    String
  run                      EcuAnalysisRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  originalFileId           String
  originalFile             EcuCorpusFile              @relation("EcuOriginalFile", fields: [originalFileId], references: [id], onDelete: Cascade)
  modifiedFileId           String
  modifiedFile             EcuCorpusFile              @relation("EcuModifiedFile", fields: [modifiedFileId], references: [id], onDelete: Cascade)
  confidence               Float                      @default(0)
  sizeBytes                BigInt
  shaDistance              Float?
  changedRegions           Json?
  probableModificationType String?
  changedMapCandidates     Json?
  evidence                 Json?
  modificationSignatures   EcuModificationSignature[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@unique([runId, originalFileId, modifiedFileId])
  @@index([runId])
  @@index([confidence])
}

model EcuModificationSignature {
  id            String          @id @default(cuid())
  runId         String
  run           EcuAnalysisRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  clusterId     String?
  cluster       EcuFileCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  pairId        String?
  pair          EcuOriModPair?  @relation(fields: [pairId], references: [id], onDelete: SetNull)
  signatureType String
  signatureKey  String
  confidence    Float           @default(0)
  regions       Json?
  evidence      Json?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([runId])
  @@index([clusterId])
  @@index([pairId])
  @@index([signatureType])
  @@index([confidence])
}

model EcuChecksumCandidate {
  id         String        @id @default(cuid())
  fileId     String
  file       EcuCorpusFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  family     String
  offset     BigInt?
  length     Int?
  confidence Float         @default(0)
  evidence   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([fileId])
  @@index([family])
  @@index([confidence])
}

model EcuDtcCandidate {
  id          String        @id @default(cuid())
  fileId      String
  file        EcuCorpusFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  offset      BigInt?
  length      Int?
  encoding    String
  confidence  Float         @default(0)
  sampleCodes Json?
  evidence    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([fileId])
  @@index([encoding])
  @@index([confidence])
}

model EcuLearnedSignature {
  id            String          @id @default(cuid())
  runId         String
  run           EcuAnalysisRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  clusterId     String?
  cluster       EcuFileCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  signatureType String
  signatureKey  String
  label         String
  confidence    Float           @default(0)
  evidence      Json?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([runId])
  @@index([clusterId])
  @@index([signatureType])
  @@index([signatureKey])
  @@index([confidence])
}

model EcuFileHashCache {
  id               String   @id @default(cuid())
  fullPath         String   @unique
  sizeBytes        BigInt
  modifiedAtOnDisk DateTime
  sha256           String
  sampledHash      String?
  lastRunId        String?
  lastIndexedAt    DateTime @default(now())
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sha256])
  @@index([lastRunId])
  @@index([modifiedAtOnDisk])
  @@index([sizeBytes])
}

model EcuIngestionCheckpoint {
  id              String         @id @default(cuid())
  runId           String
  run             EcuAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage           String
  status          String         @default("RUNNING")
  rootPath        String
  lastPath        String?
  discoveredFiles Int            @default(0)
  skippedFiles    Int            @default(0)
  processedFiles  Int            @default(0)
  failedFiles     Int            @default(0)
  batchCount      Int            @default(0)
  metrics         Json?
  pausedAt        DateTime?
  startedAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([runId, stage])
  @@index([stage, status])
  @@index([rootPath])
}

model EcuCorpusRelationStage {
  id           String         @id @default(cuid())
  runId        String
  run          EcuAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  fileId       String?
  fullPath     String?
  relationType String
  relationKey  String
  confidence   Float          @default(0)
  payload      Json?
  evidenceHash String?
  status       String         @default("PENDING")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([runId, fileId, relationType, relationKey])
  @@index([runId, relationType])
  @@index([runId, status])
  @@index([relationType, relationKey])
  @@index([fileId])
  @@index([evidenceHash])
}

model EcuCorpusMetric {
  id        String         @id @default(cuid())
  runId     String
  run       EcuAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage     String
  metricKey String
  value     Float
  unit      String?
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([runId, stage])
  @@index([metricKey])
  @@index([createdAt])
}
