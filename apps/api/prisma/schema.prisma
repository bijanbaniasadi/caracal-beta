generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  phone               String?
  companyName         String?
  workshopName        String?
  passwordHash        String?
  role                UserRole             @default(CUSTOMER)
  isActive            Boolean              @default(true)
  lastLoginAt         DateTime?
  carts               Cart[]
  orders              Order[]
  articles            Article[]            @relation("ArticleAuthor")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  ecuPatcherAccess    EcuPatcherAccess?
  ecuPatcherJobs      EcuPatcherJob[]
  catalogApprovalLogs CatalogApprovalLog[] @relation("CatalogApprovalAdmin")
  createdMasterProducts MasterProduct[]    @relation("MasterProductCreatedBy")
  updatedMasterProducts MasterProduct[]    @relation("MasterProductUpdatedBy")
  catalogAdminAuditLogs AdminAuditLog[]    @relation("CatalogAdminAuditUser")
  assignedReviewQueueItems ReviewQueue[]   @relation("ReviewQueueAssignedTo")
  resolvedReviewQueueItems ReviewQueue[]   @relation("ReviewQueueResolvedBy")
  selectedCuratedPrices CuratedProductPrice[] @relation("CuratedProductPriceSelectedBy")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}


enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum IntakeStatus {
  NEW
  IN_REVIEW
  RESPONDED
  CLOSED
  SPAM
}

enum BinUploadStatus {
  RECEIVED
  VALIDATED
  REJECTED
  STORED
}

enum BinAnalysisJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum BinAnalysisStage {
  QUEUED
  FILE_HASHING
  MCU_DETECTION
  METADATA_EXTRACTION
  RESULT_STORAGE
  COMPLETED
  FAILED
}

enum BinAnalysisResultKind {
  PIPELINE_SUMMARY
  FILE_METADATA
  MCU_DETECTION
}

enum EcuPatcherAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EcuPatcherModule {
  DCM71B_DPF
  DCM71B_EGR
  SID208_DPF_EGR
  DTC_REMOVER
}

enum EcuPatcherJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  REJECTED
}

enum StorageProvider {
  LOCAL
  R2
}

enum AuditActorType {
  ANONYMOUS
  USER
  SYSTEM
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SupplierSyncMode {
  DRY_RUN
  STAGE
  PUBLISH
}

enum SupplierSyncRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum StagingProductStatus {
  PENDING
  READY
  APPROVED
  REJECTED
  PUBLISHED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

enum CatalogProductStatus {
  DRAFT          @map("draft")
  PENDING_REVIEW @map("pending_review")
  PUBLISHED      @map("published")
  ARCHIVED       @map("archived")

  @@map("product_status")
}

enum IngestionStatus {
  RUNNING   @map("running")
  COMPLETED @map("completed")
  FAILED    @map("failed")
  PARTIAL   @map("partial")

  @@map("ingestion_status")
}

enum RawMatchStatus {
  UNMATCHED     @map("unmatched")
  AUTO_MATCHED  @map("auto_matched")
  ADMIN_MATCHED @map("admin_matched")
  REJECTED      @map("rejected")

  @@map("raw_match_status")
}

enum OfferStatus {
  ACTIVE       @map("active")
  PAUSED       @map("paused")
  DISCONTINUED @map("discontinued")

  @@map("offer_status")
}

enum ReviewAction {
  CREATE_MASTER    @map("create_master")
  ATTACH_TO_MASTER @map("attach_to_master")
  REJECT           @map("reject")
  DUPLICATE        @map("duplicate")
  ARCHIVE          @map("archive")

  @@map("review_action")
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CHECKED_OUT
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  FULFILLED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RefundStatus {
  NONE
  REQUESTED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  familyId          String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdAt])
}

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  contentHtml    String?
  status         ArticleStatus @default(DRAFT)
  category       String?
  coverImage     String?
  thumbnailImage String?
  seoTitle       String?
  seoDescription String?
  keywords       String[]      @default([])
  isFeatured     Boolean       @default(false)
  authorId       String?
  author         User?         @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  metadata       Json?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@index([authorId])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([createdAt])
}

model Supplier {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  websiteUrl   String?
  notes        String?
  metadata     Json?
  products     Product[]
  syncSources  SupplierSource[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([name])
  @@index([createdAt])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([createdAt])
}

model Product {
  id               String           @id @default(cuid())
  sku              String           @unique
  slug             String           @unique
  name             String
  shortDescription String?
  description      String?
  status           ProductStatus    @default(DRAFT)
  priceCents       Int?
  currency         String           @default("AED")
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  inventoryItems   InventoryItem[]
  stagingProducts StagingProduct[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  inquiries        ProductInquiry[]
  isFeatured       Boolean          @default(false)
  isB2BEligible    Boolean          @default(false)
  isTradeOnly      Boolean          @default(false)
  tradePriceCents  Int?
  attributes       Json?
  metadata         Json?
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([supplierId])
  @@index([isFeatured])
  @@index([isB2BEligible])
  @@index([isTradeOnly])
  @@index([createdAt])
  @@index([status, categoryId, name, id])
  @@index([status, name, id])
  @@index([status, priceCents, id])
  @@index([status, isFeatured, name, id])
}

model SupplierSource {
  id             String                    @id @default(cuid())
  supplierId     String?
  supplier       Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  slug           String                    @unique
  name           String
  baseUrl        String
  currency       String                    @default("AED")
  isActive       Boolean                   @default(true)
  scrapeAllowed  Boolean?
  robotsSummary  String?
  metadata       Json?
  syncRuns       SupplierSyncRun[]
  stagingProducts StagingProduct[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([supplierId])
  @@index([isActive])
  @@index([createdAt])
}

model SupplierSyncRun {
  id                 String                @id @default(cuid())
  sourceId           String?
  source             SupplierSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  mode               SupplierSyncMode
  status             SupplierSyncRunStatus @default(RUNNING)
  startedAt          DateTime              @default(now())
  finishedAt         DateTime?
  discoveredCount    Int                   @default(0)
  stagedCount        Int                   @default(0)
  acceptedCount      Int                   @default(0)
  reviewCount        Int                   @default(0)
  rejectedCount      Int                   @default(0)
  publishedCount     Int                   @default(0)
  errorMessage       String?
  metadata           Json?
  stagingProducts    StagingProduct[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([sourceId])
  @@index([mode])
  @@index([status])
  @@index([startedAt])
}

model StagingProduct {
  id                  String               @id @default(cuid())
  sourceId            String
  source              SupplierSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  runId               String?
  run                 SupplierSyncRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  matchedProductId    String?
  matchedProduct      Product?             @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)
  sourceProductKey    String
  externalUrl         String
  externalSku         String?
  normalizedSku       String?
  externalName        String
  normalizedName      String
  brand               String?
  categoryName        String?
  rawPriceCents       Int?
  rawCurrency         String?
  convertedPriceCents Int?
  salePriceCents      Int?
  oldPriceCents       Int?
  discountPercent     Int                  @default(10)
  marginPercent       Int                  @default(15)
  stockStatus         InventoryStatus      @default(IN_STOCK)
  imageUrl            String?
  imageApproved       Boolean              @default(false)
  status              StagingProductStatus @default(PENDING)
  warnings            Json?
  rejectReasons       Json?
  readyChecklist      Json?
  changedFields       Json?
  rawData             Json?
  normalizedData      Json?
  firstSeenAt         DateTime             @default(now())
  lastSeenAt          DateTime             @default(now())
  approvedAt          DateTime?
  publishedAt         DateTime?
  approvalLogs        CatalogApprovalLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([sourceId, sourceProductKey])
  @@index([sourceId])
  @@index([runId])
  @@index([matchedProductId])
  @@index([status])
  @@index([normalizedSku])
  @@index([lastSeenAt])
}

model VendorSource {
  id              BigInt             @id @default(autoincrement())
  slug            String             @unique @db.Citext
  name            String
  baseUrl         String             @map("base_url")
  enabled         Boolean            @default(true)
  scrapeCadence   String             @default("24 hours") @map("scrape_cadence")
  lastScrapedAt   DateTime?          @map("last_scraped_at") @db.Timestamptz(6)
  notes           String?
  ingestionRuns   IngestionRun[]
  rawProducts     VendorRawProduct[]
  offers          VendorOffer[]
  productImages   CatalogProductImage[]
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("vendor_sources")
}

model Manufacturer {
  id             BigInt               @id @default(autoincrement())
  slug           String               @unique @db.Citext
  name           String
  website        String?
  logoImageId    BigInt?              @map("logo_image_id")
  logoImage      CatalogProductImage? @relation("ManufacturerLogoImage", fields: [logoImageId], references: [id], onDelete: SetNull)
  masterProducts MasterProduct[]
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("manufacturers")
}

model CatalogTag {
  id             BigInt             @id @default(autoincrement())
  slug           String             @unique @db.Citext
  name           String
  masterProducts MasterProductTag[]
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tags")
}

model CatalogCategory {
  id             BigInt          @id @default(autoincrement())
  parentId       BigInt?         @map("parent_id")
  parent         CatalogCategory? @relation("CatalogCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       CatalogCategory[] @relation("CatalogCategoryHierarchy")
  slug           String          @db.Citext
  name           String
  description    String?
  sortOrder      Int             @default(0) @map("sort_order")
  masterProducts MasterProduct[]
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([parentId, slug])
  @@index([parentId])
  @@map("categories")
}

model IngestionRun {
  id            BigInt             @id @default(autoincrement())
  vendorId      BigInt             @map("vendor_id")
  vendor        VendorSource       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?          @map("finished_at") @db.Timestamptz(6)
  status        IngestionStatus    @default(RUNNING)
  pagesScraped  Int                @default(0) @map("pages_scraped")
  productsFound Int                @default(0) @map("products_found")
  errors        Json               @default("[]")
  triggeredBy   String             @map("triggered_by")
  rawProducts   VendorRawProduct[]

  @@index([vendorId])
  @@index([status])
  @@index([startedAt])
  @@map("ingestion_runs")
}

model VendorRawProduct {
  id                 BigInt             @id @default(autoincrement())
  ingestionRunId     BigInt             @map("ingestion_run_id")
  ingestionRun       IngestionRun       @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)
  vendorId           BigInt             @map("vendor_id")
  vendor             VendorSource       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorUrl          String             @map("vendor_url")
  vendorSku          String?            @map("vendor_sku")
  rawName            String?            @map("raw_name")
  rawDescription     String?            @map("raw_description")
  rawPriceText       String?            @map("raw_price_text")
  parsedPriceCents   BigInt?            @map("parsed_price_cents")
  parsedCurrency     String?            @map("parsed_currency") @db.Char(3)
  parsedInStock      Boolean?           @map("parsed_in_stock")
  rawSpecs           Json?              @map("raw_specs")
  rawImageUrls       String[]           @default([]) @map("raw_image_urls")
  rawHtmlStorageKey  String?            @map("raw_html_storage_key")
  fingerprint        String
  matchedProductId   BigInt?            @map("matched_product_id")
  matchedProduct     MasterProduct?     @relation("VendorRawProductMatch", fields: [matchedProductId], references: [id], onDelete: SetNull)
  matchStatus        RawMatchStatus     @default(UNMATCHED) @map("match_status")
  matchConfidence    Decimal?           @map("match_confidence") @db.Decimal(3, 2)
  scrapedAt          DateTime           @default(now()) @map("scraped_at") @db.Timestamptz(6)
  images             VendorRawImage[]
  reviewQueue        ReviewQueue?

  @@unique([ingestionRunId, vendorId, vendorUrl])
  @@index([ingestionRunId])
  @@index([vendorId])
  @@index([fingerprint])
  @@index([matchStatus])
  @@index([matchedProductId])
  @@map("vendor_raw_products")
}


model VendorRawImage {
  id             BigInt           @id @default(autoincrement())
  rawProductId   BigInt           @map("raw_product_id")
  rawProduct     VendorRawProduct @relation(fields: [rawProductId], references: [id], onDelete: Cascade)
  originalUrl    String           @map("original_url")
  storageKey     String?          @map("storage_key")
  contentHash    String?          @map("content_hash")
  mimeType       String?          @map("mime_type")
  bytes          Int?
  width          Int?
  height         Int?
  downloadedAt   DateTime?        @map("downloaded_at") @db.Timestamptz(6)
  downloadError  String?          @map("download_error")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([rawProductId])
  @@index([rawProductId, originalUrl])
  @@index([contentHash])
  @@map("vendor_raw_images")
}

model MasterProduct {
  id                BigInt               @id @default(autoincrement())
  publicId          String               @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  slug              String               @unique @db.Citext
  sku               String?              @db.Citext
  mpn               String?              @db.Citext
  name              String
  shortDescription  String?              @map("short_description")
  longDescriptionMd String?              @map("long_description_md")
  manufacturerId    BigInt?              @map("manufacturer_id")
  manufacturer      Manufacturer?        @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  manufacturerSlug  String               @map("manufacturer_slug") @db.Citext
  manufacturerName  String               @map("manufacturer_name")
  categoryId        BigInt               @map("category_id")
  category          CatalogCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status            CatalogProductStatus @default(DRAFT)
  fingerprint       String
  featured          Boolean              @default(false)
  seoTitle          String?              @map("seo_title")
  seoDescription    String?              @map("seo_description")
  createdById       String               @map("created_by")
  createdBy         User                 @relation("MasterProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById       String               @map("updated_by")
  updatedBy         User                 @relation("MasterProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  publishedAt       DateTime?            @map("published_at") @db.Timestamptz(6)
  archivedAt        DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  offers            VendorOffer[]
  images            CatalogProductImage[]
  matchedRawProducts VendorRawProduct[]  @relation("VendorRawProductMatch")
  reviewSuggestions ReviewQueue[]        @relation("ReviewQueueSuggestion")
  curatedPrice      CuratedProductPrice?
  tags              MasterProductTag[]
  specs             MasterProductSpec[]
  compatibility     MasterProductCompatibility[]

  @@index([status])
  @@index([sku])
  @@index([categoryId])
  @@index([manufacturerId])
  @@index([manufacturerSlug])
  @@index([fingerprint])
  @@map("master_products")
}


model VendorOffer {
  id              BigInt       @id @default(autoincrement())
  productId       BigInt       @map("product_id")
  product         MasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId        BigInt       @map("vendor_id")
  vendor          VendorSource @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorSku       String?      @map("vendor_sku")
  vendorUrl       String       @map("vendor_url")
  priceCents      BigInt?      @map("price_cents")
  currency        String       @default("USD") @db.Char(3)
  inStock         Boolean?     @map("in_stock")
  lastSeenAt      DateTime     @map("last_seen_at") @db.Timestamptz(6)
  status          OfferStatus  @default(ACTIVE)
  confidence      Decimal      @default(1.00) @db.Decimal(3, 2)
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  priceHistory    PriceHistory[]
  curatedSelections CuratedProductPrice[]

  @@unique([vendorId, vendorUrl])
  @@index([productId])
  @@index([vendorId])
  @@index([status])
  @@map("vendor_offers")
}

model PriceHistory {
  id          BigInt      @id @default(autoincrement())
  offerId     BigInt      @map("offer_id")
  offer       VendorOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  priceCents  BigInt      @map("price_cents")
  currency    String      @db.Char(3)
  inStock     Boolean?    @map("in_stock")
  observedAt  DateTime    @default(now()) @map("observed_at") @db.Timestamptz(6)

  @@index([offerId, observedAt(sort: Desc)], map: "price_history_offer_time_idx")
  @@map("price_history")
}

model CuratedProductPrice {
  id              BigInt        @id @default(autoincrement())
  productId       BigInt        @unique @map("product_id")
  product         MasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  selectedOfferId BigInt?       @map("selected_offer_id")
  selectedOffer   VendorOffer?  @relation(fields: [selectedOfferId], references: [id], onDelete: SetNull)
  priceCents      BigInt        @map("price_cents")
  currency        String        @default("USD") @db.Char(3)
  reason          String?
  selectedById    String        @map("selected_by")
  selectedBy      User          @relation("CuratedProductPriceSelectedBy", fields: [selectedById], references: [id], onDelete: Restrict)
  selectedAt      DateTime      @default(now()) @map("selected_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([selectedOfferId], map: "curated_product_prices_offer_idx")
  @@index([selectedById], map: "curated_product_prices_selected_by_idx")
  @@index([selectedAt], map: "curated_product_prices_selected_at_idx")
  @@map("curated_product_prices")
}


model CatalogProductImage {
  id             BigInt        @id @default(autoincrement())
  productId      BigInt        @map("product_id")
  product        MasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey     String        @map("storage_key")
  width          Int?
  height         Int?
  mimeType       String?       @map("mime_type")
  altText        String?       @map("alt_text")
  isPrimary      Boolean       @default(false) @map("is_primary")
  sortOrder      Int           @default(0) @map("sort_order")
  sourceVendorId BigInt?       @map("source_vendor_id")
  sourceVendor   VendorSource? @relation(fields: [sourceVendorId], references: [id], onDelete: SetNull)
  manufacturerLogos Manufacturer[] @relation("ManufacturerLogoImage")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, sortOrder])
  @@index([sourceVendorId])
  @@map("product_images")
}


model MasterProductSpec {
  id        BigInt        @id @default(autoincrement())
  productId BigInt        @map("product_id")
  product   MasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String        @db.Citext
  value     String
