generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  carts     Cart[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum IntakeStatus {
  NEW
  IN_REVIEW
  RESPONDED
  CLOSED
  SPAM
}

enum BinUploadStatus {
  RECEIVED
  VALIDATED
  REJECTED
  STORED
}

enum StorageProvider {
  LOCAL
  R2
}

enum AuditActorType {
  ANONYMOUS
  USER
  SYSTEM
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CHECKED_OUT
  EXPIRED
}

model Supplier {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  websiteUrl   String?
  notes        String?
  metadata     Json?
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([name])
  @@index([createdAt])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([createdAt])
}

model Product {
  id               String           @id @default(cuid())
  sku              String           @unique
  slug             String           @unique
  name             String
  shortDescription String?
  description      String?
  status           ProductStatus    @default(DRAFT)
  priceCents       Int?
  currency         String           @default("AED")
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  inventoryItems   InventoryItem[]
  cartItems        CartItem[]
  inquiries        ProductInquiry[]
  isFeatured       Boolean          @default(false)
  isB2BEligible    Boolean          @default(false)
  isTradeOnly      Boolean          @default(false)
  tradePriceCents  Int?
  attributes       Json?
  metadata         Json?
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([supplierId])
  @@index([isFeatured])
  @@index([isB2BEligible])
  @@index([isTradeOnly])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, url])
  @@index([productId, sortOrder])
  @@index([isPrimary])
}

model InventoryItem {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationKey      String          @default("default")
  locationLabel    String?
  quantityOnHand   Int             @default(0)
  quantityReserved Int             @default(0)
  reorderPoint     Int             @default(0)
  status           InventoryStatus @default(IN_STOCK)
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([productId, locationKey])
  @@index([status])
  @@index([createdAt])
}

model Cart {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId   String?    @unique
  status      CartStatus @default(ACTIVE)
  currency    String     @default("AED")
  items       CartItem[]
  metadata    Json?
  expiresAt   DateTime?
  convertedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int      @default(1)
  unitPriceCents Int?
  currency       String   @default("AED")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
  @@index([createdAt])
}

model BinUpload {
  id               String          @id @default(cuid())
  originalFileName String
  storedObjectKey  String          @unique
  storageProvider  StorageProvider @default(LOCAL)
  mimeType         String
  byteSize         Int
  sha256           String
  status           BinUploadStatus @default(RECEIVED)
  requesterName    String?
  requesterEmail   String?
  productContext   String?
  notes            String?
  rejectionReason  String?
  metadata         Json?
  quoteRequestId   String?
  quoteRequest     QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([requesterEmail])
  @@index([sha256])
  @@index([quoteRequestId])
  @@index([createdAt])
}

model QuoteRequest {
  id             String       @id @default(cuid())
  referenceCode  String       @unique
  customerName   String
  customerEmail  String
  customerPhone  String?
  companyName    String?
  workshopName   String?
  vehicleDetails String?
  requestedItems Json?
  message        String
  status         IntakeStatus @default(NEW)
  source         String       @default("api")
  metadata       Json?
  binUploads     BinUpload[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
}

model ProductInquiry {
  id            String       @id @default(cuid())
  referenceCode String       @unique
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSku    String?
  productName   String
  customerName  String
  customerEmail String
  customerPhone String?
  companyName   String?
  quantity      Int?
  message       String
  status        IntakeStatus @default(NEW)
  source        String       @default("api")
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([customerEmail])
  @@index([productId])
  @@index([productSku])
  @@index([status])
  @@index([createdAt])
}

model WorkshopConsultationLead {
  id                String       @id @default(cuid())
  referenceCode     String       @unique
  workshopName      String
  contactName       String
  contactEmail      String
  contactPhone      String?
  location          String?
  monthlyVolume     Int?
  serviceInterests  Json?
  preferredTimeline String?
  message           String
  status            IntakeStatus @default(NEW)
  source            String       @default("api")
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([contactEmail])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType @default(ANONYMOUS)
  actorId    String?
  action     String
  entityType String
  entityId   String?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([requestId])
  @@index([createdAt])
}
